<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RepasoMAUI.Models"
             xmlns:vm="clr-namespace:RepasoMAUI.ViewModels"
             x:DataType="vm:ApiViewModel"
             x:Class="RepasoMAUI.Views.ApiPage"
             Title="Catálogo Online">

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="16"
          RowSpacing="12">

        <!-- Busy Indicator de Fiori -->
        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center" />

        <!-- Message Strip de error + acción para reintentar -->
        <Border Grid.Row="0"
                Style="{StaticResource FioriMensajeError}"
                IsVisible="{Binding HasError}">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource FioriNegative}"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Reintentar"
                        Style="{StaticResource FioriBotonSecundario}"
                        Command="{Binding CargarProductosCommand}" />
            </Grid>
        </Border>

        <Label Grid.Row="1"
               Style="{StaticResource FioriTituloSeccion}"
               Text="{Binding Productos.Count, StringFormat='Productos ({0})'}"
               IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />

        <!-- Lista (visible solo cuando NO está cargando) -->
        <Border Grid.Row="2"
                Style="{StaticResource FioriTarjeta}"
                IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
            <CollectionView ItemsSource="{Binding Productos}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Producto">
                        <VerticalStackLayout>
                            <Grid Padding="16,12"
                                  ColumnSpacing="12"
                                  ColumnDefinitions="56,*,Auto">

                                <Border Style="{StaticResource FioriAvatar}"
                                        BackgroundColor="{StaticResource White}"
                                        HeightRequest="56"
                                        WidthRequest="56">
                                    <Image Source="{Binding ImagenUrl}"
                                           Aspect="AspectFit" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="2">
                                    <Label Text="{Binding Modelo}"
                                           Style="{StaticResource FioriItemTitulo}" />
                                    <Label Text="{Binding Color}"
                                           Style="{StaticResource FioriEtiqueta}" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Style="{StaticResource FioriNumero}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Precio, StringFormat='${0:N2}'}"
                                                  FontFamily="Fiori72Bold" />
                                            <Span Text=" USD"
                                                  FontFamily="Fiori72"
                                                  FontSize="12"
                                                  TextColor="{StaticResource FioriLabel}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </Grid>

                            <BoxView Style="{StaticResource FioriSeparador}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>
