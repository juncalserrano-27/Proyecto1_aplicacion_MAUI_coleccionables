<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RepasoMAUI.Models"
             xmlns:vm="clr-namespace:RepasoMAUI.ViewModels"
             x:DataType="vm:ListaViewModel"
             x:Class="RepasoMAUI.Views.ListaPage">

    <CollectionView ItemsSource="{Binding Productos}"
                    SelectionMode="None"
                    Margin="10">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Producto">
                <Grid Padding="10"
                      ColumnDefinitions="80,*,Auto">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListaViewModel}}, Path=VerDetalleCommand}"
                                              CommandParameter="{Binding .}" />
                    </Grid.GestureRecognizers>

                    <Image Source="{Binding ImagenUrl}"
                           HeightRequest="60"
                           WidthRequest="60"
                           Aspect="AspectFill"
                           Grid.Column="0" />

                    <VerticalStackLayout Grid.Column="1"
                                         Margin="10,0,0,0"
                                         VerticalOptions="Center">
                        <Label Text="{Binding Modelo}"
                               FontAttributes="Bold"
                               FontSize="16" />
                        <Label Text="{Binding Color}"
                               FontSize="12"
                               TextColor="Gray"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>

                    <Label Text="{Binding Precio, StringFormat='${0:N2}'}"
                           Grid.Column="2"
                           VerticalOptions="Center"
                           FontAttributes="Bold" />
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
