<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RepasoMAUI.Models"
             xmlns:vm="clr-namespace:RepasoMAUI.ViewModels"
             x:DataType="vm:ListaViewModel"
             x:Class="RepasoMAUI.Views.ListaPage"
             Title="Catálogo">

    <!-- Acciones de la página en la Shell Bar -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Agregar"
                     Command="{Binding IrAFormularioCommand}" />
        <ToolbarItem Text="Eliminar"
                     Command="{Binding ActivarEliminarCommand}" />
        <ToolbarItem Text="Favoritos"
                     Command="{Binding IrAFavoritosCommand}" />
    </ContentPage.ToolbarItems>

    <!-- Patrón Fiori "List Report": título con contador + lista en una tarjeta -->
    <Grid RowDefinitions="Auto,*"
          Padding="16"
          RowSpacing="12">

        <Label Grid.Row="0"
               Style="{StaticResource FioriTituloSeccion}"
               Text="{Binding Productos.Count, StringFormat='Productos ({0})'}" />

        <Border Grid.Row="1"
                Style="{StaticResource FioriTarjeta}">
            <CollectionView ItemsSource="{Binding Productos}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Producto">
                        <!-- "Standard List Item" de Fiori: avatar, título, descripción, número y flecha -->
                        <VerticalStackLayout>
                            <Grid Padding="16,12"
                                  ColumnDefinitions="Auto,56,*,Auto,Auto">

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListaViewModel}}, Path=VerDetalleCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <!-- Checkbox: solo visible en modo eliminar -->
                                <CheckBox Grid.Column="0"
                                          IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ListaViewModel}}, Path=ModoEliminar}"
                                          CheckedChanged="CheckBox_CheckedChanged"
                                          Margin="0,0,8,0"
                                          VerticalOptions="Center" />

                                <Border Grid.Column="1"
                                        Style="{StaticResource FioriAvatar}"
                                        HeightRequest="56"
                                        WidthRequest="56">
                                    <Image Source="{Binding ImagenUrl}"
                                           Aspect="AspectFill" />
                                </Border>

                                <VerticalStackLayout Grid.Column="2"
                                                     Margin="12,0"
                                                     VerticalOptions="Center"
                                                     Spacing="2">
                                    <Label Text="{Binding Modelo}"
                                           Style="{StaticResource FioriItemTitulo}" />
                                    <Label Text="{Binding Color}"
                                           Style="{StaticResource FioriEtiqueta}" />
                                </VerticalStackLayout>

                                <!-- "Object Number": cifra en negritas + unidad en gris -->
                                <Label Grid.Column="3"
                                       Style="{StaticResource FioriNumero}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Precio, StringFormat='${0:N2}'}"
                                                  FontFamily="Fiori72Bold" />
                                            <Span Text=" MXN"
                                                  FontFamily="Fiori72"
                                                  FontSize="12"
                                                  TextColor="{StaticResource FioriLabel}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <!-- Flecha: indica que el renglón navega a un detalle -->
                                <Label Grid.Column="4"
                                       Margin="12,0,0,0"
                                       Text="›"
                                       FontSize="24"
                                       TextColor="{StaticResource FioriLabel}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <BoxView Style="{StaticResource FioriSeparador}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>
