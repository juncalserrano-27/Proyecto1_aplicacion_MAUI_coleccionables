<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RepasoMAUI.ViewModels"
             x:Class="RepasoMAUI.Views.FormularioPage"
             x:DataType="vm:FormularioViewModel"
             Title="Agregar producto">

    <!-- Patrón Fiori de formulario: etiquetas arriba del campo (móvil),
         obligatorios con asterisco y acciones en el Footer Toolbar -->
    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16"
                                 Spacing="12">

                <!-- Message Strip de error: solo se ve cuando hay mensaje -->
                <Border Style="{StaticResource FioriMensajeError}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding Mensaje}" Value="{x:Null}">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding Mensaje}" Value="">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="{Binding Mensaje}"
                           TextColor="{StaticResource FioriNegative}" />
                </Border>

                <Label Text="Datos del producto"
                       Style="{StaticResource FioriTituloSeccion}" />

                <Border Style="{StaticResource FioriTarjeta}"
                        Padding="16">
                    <VerticalStackLayout Spacing="4">

                        <Label Style="{StaticResource FioriEtiqueta}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Modelo" />
                                    <Span Text=" *" TextColor="{StaticResource FioriNegative}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Border Style="{StaticResource FioriCampo}">
                            <Entry Text="{Binding Modelo}" Placeholder="Ej. LeBron 22" />
                        </Border>

                        <Label Style="{StaticResource FioriEtiqueta}" Margin="0,8,0,0">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Color" />
                                    <Span Text=" *" TextColor="{StaticResource FioriNegative}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Border Style="{StaticResource FioriCampo}">
                            <Entry Text="{Binding Color}" Placeholder="Ej. Negro/Rojo" />
                        </Border>

                        <Label Text="Precio (MXN)"
                               Style="{StaticResource FioriEtiqueta}"
                               Margin="0,8,0,0" />
                        <Border Style="{StaticResource FioriCampo}">
                            <Entry Text="{Binding Precio}" Keyboard="Numeric" Placeholder="Ej. 3799" />
                        </Border>

                        <Label Text="Imagen (nombre del archivo)"
                               Style="{StaticResource FioriEtiqueta}"
                               Margin="0,8,0,0" />
                        <Border Style="{StaticResource FioriCampo}">
                            <Entry Text="{Binding ImagenUrl}" Placeholder="Ej. lebron_22_blancos.jpg" />
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Footer Toolbar: Cancelar (secundario) y Guardar (principal) a la derecha -->
        <Border Grid.Row="1"
                Style="{StaticResource FioriFooter}">
            <HorizontalStackLayout HorizontalOptions="End"
                                   Spacing="8">
                <Button Text="Cancelar"
                        Style="{StaticResource FioriBotonSecundario}"
                        Command="{Binding CancelarCommand}" />
                <Button Text="Guardar"
                        Command="{Binding GuardarCommand}" />
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentPage>
