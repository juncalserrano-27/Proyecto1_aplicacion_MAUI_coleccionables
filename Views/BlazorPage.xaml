<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:RepasoMAUI.Components"
             x:Class="RepasoMAUI.Views.BlazorPage"
             Shell.NavBarIsVisible="False"
             Title="Tienda">

    <!-- Página XAML nativa que contiene un BlazorWebView.
         Adentro corren los componentes Razor (HTML + C#).
         Se oculta la barra nativa: la Shell Bar de Fiori la dibuja el MainLayout. -->
    <BlazorWebView HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
