<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:RepasoMAUI.Models"
    xmlns:vm="clr-namespace:RepasoMAUI.ViewModels"
    x:Class="RepasoMAUI.Views.FavoritosPage"
    x:DataType="vm:FavoritosViewModel"
    Title="Mis favoritos">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Eliminar"
            Command="{Binding ActivarEliminarCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*"
          Padding="16"
          RowSpacing="12">

        <Label Grid.Row="0"
               Style="{StaticResource FioriTituloSeccion}"
               Text="{Binding Favoritos.Count, StringFormat='Favoritos ({0})'}" />

        <Border Grid.Row="1"
                Style="{StaticResource FioriTarjeta}">
            <CollectionView ItemsSource="{Binding Favoritos}">

                <!-- "Illustrated Message" de Fiori: estado vacío con título y explicación -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Padding="24"
                                         Spacing="8">
                        <!-- Ícono oficial de SAP "heart" (U+E293) -->
                        <Label Text="&#xe293;"
                               FontFamily="SAPIcons"
                               FontSize="56"
                               TextColor="{StaticResource FioriLabel}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Aún no hay favoritos"
                               Style="{StaticResource FioriTituloSeccion}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Agrega productos desde su detalle."
                               Style="{StaticResource FioriEtiqueta}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Producto">
                        <VerticalStackLayout>
                            <Grid Padding="16,12"
                                  ColumnDefinitions="Auto,56,*,Auto">

                                <CheckBox Grid.Column="0"
                                          IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoritosViewModel}}, Path=ModoEliminar}"
                                          CheckedChanged="CheckBox_CheckedChanged"
                                          Margin="0,0,8,0"
                                          VerticalOptions="Center" />

                                <Border Grid.Column="1"
                                        Style="{StaticResource FioriAvatar}"
                                        HeightRequest="56"
                                        WidthRequest="56">
                                    <Image Source="{Binding ImagenUrl}"
                                           Aspect="AspectFill" />
                                </Border>

                                <VerticalStackLayout Grid.Column="2"
                                                     Margin="12,0"
                                                     VerticalOptions="Center"
                                                     Spacing="2">
                                    <Label Text="{Binding Modelo}"
                                           Style="{StaticResource FioriItemTitulo}" />
                                    <Label Text="{Binding Color}"
                                           Style="{StaticResource FioriEtiqueta}" />
                                </VerticalStackLayout>

                                <Label Grid.Column="3"
                                       Style="{StaticResource FioriNumero}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Precio, StringFormat='${0:N2}'}"
                                                  FontFamily="Fiori72Bold" />
                                            <Span Text=" MXN"
                                                  FontFamily="Fiori72"
                                                  FontSize="12"
                                                  TextColor="{StaticResource FioriLabel}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </Grid>

                            <BoxView Style="{StaticResource FioriSeparador}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>
