@page "/producto/{Id}"
@using RepasoMAUI.Views
@inject ProductoRepository Repo
@inject NavigationManager Navigation
@inject INavegacionService NavegacionNativa

@if (producto is null)
{
    <div class="message-strip error">Producto no encontrado.</div>
}
else
{
    @* Object Page Header *@
    <div class="tarjeta con-padding">
        <img src="@($"images/{producto.ImagenUrl}")" style="width:100%; max-height:240px; object-fit:cover; border-radius:8px;" />
        <h1 class="titulo-objeto" style="margin-top:12px;">@producto.Modelo</h1>
        <div class="etiqueta">@producto.Color</div>
        <div class="numero grande" style="margin-top:8px;">$@producto.Precio.ToString("N2") <span class="unidad">MXN</span></div>
        <div class="positivo" style="margin-top:8px;">@mensaje</div>
    </div>

    @* Sección del Object Page: formulario de solo lectura *@
    <h2 class="titulo-seccion">Información general</h2>
    <div class="tarjeta con-padding">
        <div class="etiqueta">Modelo:</div>
        <div style="margin-bottom:12px;">@producto.Modelo</div>
        <div class="etiqueta">Color:</div>
        <div>@producto.Color</div>
    </div>

    @* Footer Toolbar: acciones abajo a la derecha, la principal en azul *@
    <div class="footer">
        <button class="btn btn-sec" @onclick='() => Navigation.NavigateTo("/")'>Regresar</button>
        @* Convivencia Razor + MAUI: desde Blazor abrimos una página XAML nativa *@
        <button class="btn btn-sec" @onclick="IrAFavoritosNativo">Ver favoritos</button>
        <button class="btn" @onclick="AgregarFavorito">Agregar a favoritos</button>
    </div>
}

@code {
    // Ruta parametrizada: el {Id} de la URL llega a esta propiedad
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private Producto? producto;
    private string mensaje = string.Empty;

    // Ciclo de vida: se ejecuta cada vez que cambia un parámetro (el Id de la ruta)
    protected override void OnParametersSet()
    {
        producto = Repo.ObtenerPorId(Id);
        mensaje = string.Empty;
    }

    private void AgregarFavorito()
    {
        Repo.AgregarFavorito(producto!);
        mensaje = "✓ Agregado a favoritos";
    }

    private async Task IrAFavoritosNativo()
        => await NavegacionNativa.IrAAsync(nameof(FavoritosPage));
}
