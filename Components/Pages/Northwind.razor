@page "/northwind"
@inject NorthwindService ODataService

<h2 class="titulo-seccion">Productos Northwind (OData)</h2>
<p class="etiqueta" style="margin-top:-6px;">Precio mayor a $20, del más caro al más barato.</p>

@if (cargando)
{
    @* Busy Indicator *@
    <div class="busy">Cargando...</div>
}
else if (error is not null)
{
    @* Message Strip de error con acción para reintentar *@
    <div class="message-strip error">
        <span>@error</span>
        <button class="btn btn-sec" @onclick="Cargar">Reintentar</button>
    </div>
}
else
{
    <div class="tarjeta">
        @foreach (var p in productos)
        {
            <div class="list-item">
                <div class="textos">
                    <div class="item-titulo">@p.ProductName</div>
                    <div class="etiqueta">Existencias: @p.UnitsInStock</div>
                </div>
                <div class="numero">$@p.UnitPrice.ToString("N2") <span class="unidad">USD</span></div>
            </div>
        }
    </div>
}

@code {
    private List<NorthwindProductoDto> productos = new();
    private bool cargando;
    private string? error;

    // Ciclo de vida asíncrono: ideal para pedir datos a un servicio
    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;
        error = null;

        (productos, error) = await ODataService.ObtenerProductosAsync();

        cargando = false;
    }
}
