@page "/"
@inject ProductoRepository Repo
@inject NavigationManager Navigation

@* Data binding: @bind con oninput filtra mientras escribes *@
<input placeholder="Buscar producto..." @bind="busqueda" @bind:event="oninput" />

<h2 class="titulo-seccion" style="margin-top:16px;">Productos (@Filtrados.Count)</h2>

<div class="tarjeta">
    @if (Filtrados.Count == 0)
    {
        @* Illustrated Message: estado vacío *@
        <div class="vacio">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#556B82" stroke-width="1.5"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" /></svg>
            <h3>No hay resultados</h3>
            <p class="etiqueta">Prueba con otro nombre.</p>
        </div>
    }

    @foreach (var producto in Filtrados)
    {
        <ProductoCard Producto="producto" OnProductoSeleccionado="VerDetalle" />
    }
</div>

@code {
    private List<Producto> productos = new();
    private string busqueda = string.Empty;

    private List<Producto> Filtrados => productos
        .Where(p => p.Modelo.Contains(busqueda, StringComparison.OrdinalIgnoreCase))
        .ToList();

    // Ciclo de vida: se ejecuta una vez al crear el componente
    // (parecido a OnAppearing en MAUI). Aquí cargamos los datos iniciales.
    protected override void OnInitialized()
    {
        // Es el mismo repositorio Singleton que usan las páginas XAML
        productos = Repo.ObtenerTodos();
    }

    // Se ejecuta cuando el componente hijo (ProductoCard) dispara el EventCallback
    private void VerDetalle(Producto producto)
        => Navigation.NavigateTo($"/producto/{producto.Id}");
}
