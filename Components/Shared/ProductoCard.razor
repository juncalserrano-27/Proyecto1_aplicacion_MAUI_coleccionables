@* Componente hijo reutilizable: un "Standard List Item" de Fiori.
   Recibe un producto y avisa al padre cuando lo seleccionan. *@
<div class="list-item" @onclick="Seleccionar">
    <img class="avatar" src="@($"images/{Producto.ImagenUrl}")" />
    <div class="textos">
        <div class="item-titulo">@Producto.Modelo</div>
        <div class="etiqueta">@Producto.Color</div>
    </div>
    <div class="numero">$@Producto.Precio.ToString("N2") <span class="unidad">@Moneda</span></div>
    <span class="flecha">›</span>
</div>

@code {
    // Parámetro que manda el componente padre
    [Parameter]
    public Producto Producto { get; set; } = default!;

    // EventCallback: el hijo le avisa al padre qué producto se eligió
    [Parameter]
    public EventCallback<Producto> OnProductoSeleccionado { get; set; }

    // Llega desde el CascadingValue del MainLayout
    [CascadingParameter]
    public string Moneda { get; set; } = string.Empty;

    private async Task Seleccionar()
        => await OnProductoSeleccionado.InvokeAsync(Producto);
}
