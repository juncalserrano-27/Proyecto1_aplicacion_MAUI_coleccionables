<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Estilos según las SAP Fiori Design Guidelines (tema Horizon).
        - Tipografía: fuente oficial "72" de SAP.
        - Estilos implícitos (sin x:Key): se aplican solos a todos los controles de ese tipo.
        - Estilos con x:Key: se usan a propósito con Style="{StaticResource ...}".
    -->

    <!-- ============ Estructura: Shell Bar y fondo ============ -->

    <!-- Shell Bar de Fiori: barra blanca arriba, título oscuro, tab activo en azul -->
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource FioriShell}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource FioriBrandText}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource FioriText}" />
        <Setter Property="Shell.NavBarHasShadow" Value="True" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource FioriShell}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource FioriBrand}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource FioriBrand}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource FioriLabel}" />
        <Setter Property="Shell.UnselectedColor" Value="{StaticResource FioriLabel}" />
    </Style>

    <!-- Fondo gris claro de Fiori; el contenido va encima en tarjetas blancas -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource FioriBackground}" />
    </Style>

    <!-- ============ Texto ============ -->

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource FioriText}" />
        <Setter Property="FontFamily" Value="Fiori72" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Título de página / Object Header -->
    <Style TargetType="Label" x:Key="FioriTitulo">
        <Setter Property="FontFamily" Value="Fiori72Bold" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <!-- Título de sección o de la barra de una lista ("Productos (4)") -->
    <Style TargetType="Label" x:Key="FioriTituloSeccion">
        <Setter Property="FontFamily" Value="Fiori72Bold" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- Título de un renglón de lista (Standard List Item) -->
    <Style TargetType="Label" x:Key="FioriItemTitulo">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <!-- Texto secundario / etiquetas de formulario -->
    <Style TargetType="Label" x:Key="FioriEtiqueta">
        <Setter Property="TextColor" Value="{StaticResource FioriLabel}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Object Number: cifras en negritas alineadas a la derecha -->
    <Style TargetType="Label" x:Key="FioriNumero">
        <Setter Property="FontFamily" Value="Fiori72Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ============ Contenedores ============ -->

    <!-- Tarjeta blanca con esquinas de 12 px (Horizon) -->
    <Style TargetType="Border" x:Key="FioriTarjeta">
        <Setter Property="BackgroundColor" Value="{StaticResource FioriCard}" />
        <Setter Property="Stroke" Value="{StaticResource FioriBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Footer Toolbar: barra inferior con la acción principal a la derecha -->
    <Style TargetType="Border" x:Key="FioriFooter">
        <Setter Property="BackgroundColor" Value="{StaticResource FioriShell}" />
        <Setter Property="Stroke" Value="{StaticResource FioriBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <!-- Message Strip de error -->
    <Style TargetType="Border" x:Key="FioriMensajeError">
        <Setter Property="BackgroundColor" Value="{StaticResource FioriNegativeBackground}" />
        <Setter Property="Stroke" Value="{StaticResource FioriNegativeBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- Imagen tipo "Avatar" cuadrado con esquinas redondeadas -->
    <Style TargetType="Border" x:Key="FioriAvatar">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="BackgroundColor" Value="{StaticResource FioriBackground}" />
    </Style>

    <!-- Línea separadora entre renglones de una lista -->
    <Style TargetType="BoxView" x:Key="FioriSeparador">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource FioriBorder}" />
    </Style>

    <!-- Campo de texto: borde gris oscuro, esquinas de 4 px -->
    <Style TargetType="Border" x:Key="FioriCampo">
        <Setter Property="BackgroundColor" Value="{StaticResource FioriCard}" />
        <Setter Property="Stroke" Value="{StaticResource FioriFieldBorder}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 4" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <!-- ============ Controles ============ -->

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource FioriText}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource FioriPlaceholder}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Fiori72" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="40" />
    </Style>

    <!-- Botón "Emphasized": la acción principal (solo una por pantalla) -->
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource FioriBrand}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontFamily" Value="Fiori72Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinimumHeightRequest" Value="40" />
    </Style>

    <!-- Botón "Default": acciones secundarias -->
    <Style TargetType="Button" x:Key="FioriBotonSecundario">
        <Setter Property="BackgroundColor" Value="{StaticResource FioriCard}" />
        <Setter Property="TextColor" Value="{StaticResource FioriBrandText}" />
        <Setter Property="BorderColor" Value="{StaticResource FioriButtonBorder}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="Fiori72Bold" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinimumHeightRequest" Value="40" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource FioriBrand}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource FioriBrand}" />
    </Style>

</ResourceDictionary>
