<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RepasoMAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RepasoMAUI"
    xmlns:views="clr-namespace:RepasoMAUI.Views"
       Title="RepasoMAUI">

    <ShellContent Title="Catálogo"
                  ContentTemplate="{DataTemplate views:ListaPage}"
                  Route="lista" />
    <ShellContent Title="WishList"
              ContentTemplate="{DataTemplate views:FavoritosPage}"
              Route="wishlist" />

</Shell>
